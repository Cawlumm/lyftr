# Server
PORT=3000
ENV=development

# Database (SQLite default — no changes needed for local dev)
DB_TYPE=sqlite
DB_PATH=./data/lyftr.db

# PostgreSQL (only used if DB_TYPE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lyftr
# DB_USER=postgres
# DB_PASSWORD=

# Auth
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRY=3600

# Registration — open | first-user | closed. See the root .env.example for what each
# means. An unrecognised value is a startup error, not a silent fallback to open.
REGISTRATION=open

# Demo seeding — demo@lyftr.local / password123 plus 8 weeks of sample data. Defaults to
# on when ENV=development (so `go run main.go` gives you an account to log in with) and
# off otherwise. Set it explicitly to override either way.
# DEMO_MODE=true

# CORS — comma-separated allow-list of client origins permitted to call the API.
# Use * to allow any origin (the API is Bearer-token based, so no cookies are at risk).
CORS_ORIGIN=http://localhost:5173

# ExerciseDB (RapidAPI)
# Sign up free at https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# Paste your key below — exercises are fetched once and stored locally.
# EXERCISEDB_KEY=your_rapidapi_key_here
