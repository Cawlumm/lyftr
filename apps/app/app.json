{
  "expo": {
    "name": "Lyftr",
    "slug": "lyftr",
    "scheme": "lyftr",
    "version": "0.0.0-dev",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070d1a",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.lyftr.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Lyftr uses the camera to scan food barcodes so you can log nutrition quickly.",
        "NSLocalNetworkUsageDescription": "Lyftr connects to your self-hosted Lyftr server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "local.lyftr.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1629"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Lyftr uses the camera to scan food barcodes and to take a picture for an exercise you created.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lyftr uses your photos to add a picture to an exercise you created.",
          "cameraPermission": "Lyftr uses the camera to scan food barcodes and to take a picture for an exercise you created.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#070d1a"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "allowDynamicLocaleChangesAndroid": true,
          "supportedLocales": { "ios": ["en", "es"], "android": ["en", "es"] }
        }
      ],
      [
        "expo-network-security-config",
        {
          "enable": true,
          "networkSecurityConfig": "./network_security_config.xml"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0025f81b-fbc5-4bd1-8b12-521725e1425a"
      }
    },
    "owner": "cwlumm"
  }
}
