{
  // Production build only. `npm run type-check` uses tsconfig.json and still covers the
  // tests; this config exists because the frontend image installs production dependencies
  // only, so the @types/node that tests rely on (node:fs, __dirname in the dateUtils fork
  // guard) is absent there. Locally those types resolve from the hoisted root
  // node_modules, which is why the build passes here and failed in Docker.
  //
  // Excluding tests from the *build* costs nothing: nothing shipped imports them, and
  // type-check keeps checking them.
  "extends": "./tsconfig.json",
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "e2e"]
}
