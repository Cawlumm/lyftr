{
  "name": "lyfter-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test:unit": "cross-env TZ=America/New_York vitest run",
    "test:unit:watch": "cross-env TZ=America/New_York vitest",
    "coverage": "cross-env TZ=America/New_York vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:docker": "cross-env E2E_DOCKER=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings=55"
  },
  "dependencies": {
    "@lyftr/shared": "*",
    "@tanstack/react-virtual": "^3.13.24",
    "axios": "^1.6.2",
    "date-fns": "^3.0.0",
    "lucide-react": "^1.8.0",
    "react": "19.1.0",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "19.1.0",
    "react-router-dom": "^6.22.0",
    "react-zxing": "^2.1.0",
    "recharts": "^2.10.3",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
