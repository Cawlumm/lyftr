# Copy to .env.local (gitignored) and set the backend this machine talks to.
#
# EXPO_PUBLIC_-prefixed variables are statically inlined into the JS bundle at build time,
# which is what makes this work without any runtime lookup — and why nothing secret belongs
# here: https://docs.expo.dev/guides/environment-variables/
#
# It only fills the server field when you have not saved one in the app. A URL you set in
# Settings always wins, on every platform.

# Android emulator — 10.0.2.2 is its alias for your machine's loopback
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# iOS simulator and web share the host's loopback
# EXPO_PUBLIC_API_URL=http://localhost:3000

# A physical device on the same network needs your machine's LAN address
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
