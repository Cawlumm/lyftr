---
import { Image } from 'astro:assets';
import '../styles/tailwind.css';

import banner from '../assets/banner.png';
import heroDesktop from '../assets/dashboard-dark-desktop.png';
import heroPhone from '../assets/dashboard-dark-mobile.png';
import shotProgram from '../assets/program-detail-desktop.png';
import shotActive from '../assets/active-workout-mobile.png';
import shotGymDesktop from '../assets/gym-mode-overview-desktop.png';
import shotGymPhone from '../assets/gym-mode-exercise-mobile.png';
import shotExercise from '../assets/exercise-detail-desktop.png';
import shotCharts from '../assets/dashboard-charts-desktop.png';
import shotFood from '../assets/food-desktop.png';
import shotFoodTrends from '../assets/food-trends-mobile.png';
import shotWeight from '../assets/weight-mobile.png';

// Normalize to always end in '/', so `${base}getting-started/` joins correctly. Astro's
// BASE_URL can come back without a trailing slash (e.g. '/lyftr'), which would mangle links.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const DEMO = 'https://lyftr-demo.fly.dev';
const REPO = 'https://github.com/Cawlumm/lyftr';
const DISCORD = 'https://discord.gg/hfFWsrebQA';
// Not /releases/latest and not ?q=mobile-v: every release ships as a prerelease so
// /latest 302s to the list, and mobile-v* was retired when #77 unified the tag namespace
// (RELEASING.md) — that filter still resolves, to a stale July build.
const APK = 'https://github.com/Cawlumm/lyftr/releases';

const title = 'Lyftr — Self-Hosted Workout Tracker & Hevy / Strong Alternative (Open Source)';
const description =
  'Lyftr is a free, self-hosted, open-source workout & nutrition tracker — a no-subscription alternative to Hevy and Strong. One app for the browser and Android, your data in one SQLite file. Deploy with Docker on a Raspberry Pi, NAS, or VPS.';

const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(banner.src, Astro.site).href;
const logoUrl = new URL('logo.svg', Astro.site).href;

const proof = [
  { label: '300+ GitHub stars', href: REPO }, // hand-maintained; bump it when it drifts
  { label: 'Featured in selfh.st', href: 'https://selfh.st/weekly/2026-04-24/' },
  { label: 'Runs on Pi · NAS · $5 VPS' },
  { label: 'MIT · Free · No subscription' },
];

// The tour: each row pairs a desktop frame with a phone frame of the same feature, since
// "one app on every screen" is the claim the screenshots have to carry.
const tour = [
  {
    kicker: 'Plan',
    t: 'Train from a program, not a blank page',
    d: 'Build reusable programs with target sets, reps and weight per day. Lyftr knows which day is next, starts it in one tap, and logs every set against the plan, with a rest timer between them.',
    desktop: shotProgram,
    desktopAlt: 'A push/pull/legs program on desktop, showing each day and its target sets',
    phone: shotActive,
    phoneAlt: 'Logging sets during a workout on a phone',
  },
  {
    kicker: 'Lift',
    t: 'Gym Mode: one exercise, big buttons',
    d: 'Switch the active workout to Gym Mode and Lyftr shows one exercise at a time with large steppers and a single Complete Set button. Full screen on a phone, a focused dialog on a desktop.',
    desktop: shotGymDesktop,
    desktopAlt: 'Gym Mode workout overview as a dialog on desktop',
    phone: shotGymPhone,
    phoneAlt: 'Gym Mode on a phone: set targets, reps and weight steppers, Complete Set',
  },
  {
    kicker: 'Progress',
    t: 'See what the work adds up to',
    d: 'Each exercise page shows its photo, instructions, the muscles it works, your personal best and a weight-progression chart. The dashboard tracks volume, muscle balance, bodyweight and a 12-week consistency heatmap.',
    desktop: shotExercise,
    desktopAlt: 'Exercise detail on desktop: photo, muscle diagram, personal best and progression chart',
    phone: shotWeight,
    phoneAlt: 'Bodyweight log and trend on a phone',
  },
  {
    kicker: 'Eat',
    t: 'Nutrition beside your training',
    d: 'Log meals against your own calorie and macro targets. Search foods or scan a barcode (via Open Food Facts), and watch your macros over 7, 30 or 90 days.',
    desktop: shotFood,
    desktopAlt: 'Nutrition diary on desktop with calories and macro rings',
    phone: shotFoodTrends,
    phoneAlt: 'Macro history chart on a phone',
  },
];

const features = [
  { t: '800+ exercises', d: 'Photos, instructions and muscles, downloaded from open-exercise-db and refreshed daily. No API key.' },
  { t: 'Desktop and phone', d: 'A sidebar layout on a desktop, a tab bar on a phone, and an Android app. Same features everywhere.' },
  { t: 'Light and dark', d: 'Both themes, switchable in Settings.' },
  { t: 'English and Spanish', d: 'The app and the exercise library. More languages welcome.' },
  { t: 'lbs or kg', d: 'Pick a unit once; every weight converts.' },
  { t: 'Your registration rules', d: 'Keep sign-up open, limit it to the first account, or close it.' },
];

// Why self-host — the value props (no competitor comparison).
const values = [
  { t: 'Self-hosted', d: 'Your logs never leave your server. No cloud account required.' },
  { t: 'Open source (MIT)', d: 'No black box. Read it, fork it, audit it, extend it.' },
  { t: 'Free', d: 'No subscription and no paywalled features.' },
  { t: 'Own your data', d: 'Everything lives in one SQLite file you fully control. Backing up is copying it.' },
];

const runsOn = ['Raspberry Pi 4', 'Hetzner / DigitalOcean / Oracle', 'Synology NAS', 'Proxmox LXC', 'Mac · Linux · Windows'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': canonical + '#website',
      url: canonical,
      name: 'Lyftr',
      description,
      inLanguage: 'en',
      publisher: { '@id': canonical + '#org' },
    },
    {
      '@type': 'Organization',
      '@id': canonical + '#org',
      name: 'Lyftr',
      url: canonical,
      logo: logoUrl,
      sameAs: [REPO, DISCORD],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Lyftr',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Android, Web, Docker',
      description,
      url: canonical,
      license: 'https://opensource.org/licenses/MIT',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      softwareHelp: canonical + 'getting-started/',
    },
  ],
};

const check = 'M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.3 3.3 6.8-6.8a1 1 0 011.4 0z';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#070d1a" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={banner.width.toString()} />
    <meta property="og:image:height" content={banner.height.toString()} />
    <meta property="og:image:alt" content="Lyftr — self-hosted workout tracker on phone and desktop" />
    <meta property="og:site_name" content="Lyftr" />
    <meta property="og:locale" content="en_US" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="bg-surface-base text-tx-primary font-sans">
    <!-- Nav -->
    <header class="sticky top-0 z-30 border-b border-surface-border/70 bg-surface-base/80 backdrop-blur-xl">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5">
        <a href={base} class="flex items-center gap-2 font-display text-lg font-extrabold tracking-tight">
          <img src={`${base}favicon.svg`} alt="" width="22" height="22" class="h-[22px] w-[22px]" />
          Lyftr
        </a>
        <div class="flex items-center gap-2 text-sm">
          <a href="#tour" class="hidden rounded-lg px-3 py-2 text-tx-secondary hover:text-tx-primary md:inline-block">Tour</a>
          <a href="#quick-start" class="hidden rounded-lg px-3 py-2 text-tx-secondary hover:text-tx-primary md:inline-block">Install</a>
          <a href={`${base}getting-started/`} class="hidden rounded-lg px-3 py-2 text-tx-secondary hover:text-tx-primary sm:inline-block">Docs</a>
          <a href={REPO} class="hidden rounded-lg px-3 py-2 text-tx-secondary hover:text-tx-primary sm:inline-block">GitHub</a>
          <a href={DEMO} class="rounded-lg bg-brand-500 px-4 py-2 font-semibold text-white shadow-sm transition hover:bg-brand-600">Live demo</a>
        </div>
      </nav>
    </header>

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden">
        <div class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[46rem] -translate-x-1/2 rounded-full bg-brand-500/20 blur-[120px]"></div>
        <div class="mx-auto max-w-6xl px-5 pb-10 pt-14 sm:pt-20">
          <div class="mx-auto max-w-3xl text-center">
            <span class="inline-flex items-center gap-2 rounded-full border border-surface-border bg-surface-raised px-3 py-1 text-xs font-medium text-brand-300">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span> Open source · MIT · Self-hosted
            </span>
            <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
              The self-hosted workout tracker you <span class="bg-gradient-brand bg-clip-text text-transparent">actually own</span>.
            </h1>
            <p class="mx-auto mt-5 max-w-2xl text-lg text-tx-secondary">
              Workouts, programs, nutrition and bodyweight in one app — in any browser, desktop or
              phone, and on Android. A free, no-subscription alternative to Hevy and Strong that
              keeps your data on your server.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
              <a href={DEMO} class="rounded-xl bg-brand-500 px-6 py-3.5 font-semibold text-white shadow-glow-sm transition hover:bg-brand-600">
                Try the live demo →
              </a>
              <a href="#quick-start" class="rounded-xl border border-surface-border bg-surface-raised px-6 py-3.5 font-semibold text-tx-primary transition hover:border-tx-muted">
                Self-host it
              </a>
            </div>
            <p class="mt-4 text-sm text-tx-muted">
              One tap to sign in — no account needed. Or use
              <code class="font-mono text-tx-secondary">demo@lyftr.local</code> /
              <code class="font-mono text-tx-secondary">password123</code> · resets hourly
            </p>
          </div>

          <!-- Desktop + phone, the same dashboard. -->
          <div class="relative mx-auto mt-14 max-w-5xl pb-6 sm:pb-10">
            <div class="absolute inset-x-10 top-10 bottom-0 -z-10 rounded-[2rem] bg-gradient-brand opacity-20 blur-3xl"></div>
            <div class="ml-auto w-full overflow-hidden rounded-xl border border-surface-border bg-surface-raised shadow-glow sm:w-[88%]">
              <div class="flex items-center gap-1.5 border-b border-surface-border px-3 py-2" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full bg-surface-border"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-surface-border"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-surface-border"></span>
                <span class="ml-3 h-3.5 w-48 rounded bg-surface-overlay"></span>
              </div>
              <!-- A 14-second loop recorded by scripts/capture-video.mjs. It plays only when motion
                   is allowed (the script below), so reduced-motion visitors get the poster and
                   download nothing else; the button pauses it, since it loops for longer than
                   five seconds (WCAG 2.2.2). If neither source plays, the screenshot it replaced
                   comes back from the template. -->
              <div class="relative">
                <video
                  id="hero-tour"
                  class="block aspect-[16/10] h-auto w-full bg-surface-base"
                  width="1440"
                  height="900"
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={`${base}media/tour-desktop-dark.jpg`}
                  aria-label="A short tour of Lyftr in a desktop browser: the dashboard and its charts, a push/pull/legs program, logging a set in Gym Mode with the rest timer, the nutrition diary, and the bodyweight trend"
                >
                  <source src={`${base}media/tour-desktop-dark.webm`} type="video/webm" />
                  <source src={`${base}media/tour-desktop-dark.mp4`} type="video/mp4" />
                </video>
                <template id="hero-tour-fallback">
                  <Image src={heroDesktop} alt="The Lyftr dashboard in a desktop browser, dark theme: up next, this week, calories, protein, last workout and today's nutrition" class="block w-full" widths={[640, 960, 1440]} sizes="(max-width: 1024px) 100vw, 900px" loading="eager" />
                </template>
                <button
                  id="hero-tour-toggle"
                  type="button"
                  hidden
                  aria-label="Play the tour"
                  class="absolute bottom-3 right-3 rounded-full border border-surface-border bg-surface-base/80 p-2 text-tx-secondary backdrop-blur transition hover:text-tx-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-400"
                >
                  <svg data-icon="pause" hidden class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6 4h3v12H6zM11 4h3v12h-3z" /></svg>
                  <svg data-icon="play" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6 4l10 6-10 6z" /></svg>
                </button>
              </div>
              <script is:inline>
                (() => {
                  const video = document.getElementById('hero-tour');
                  const toggle = document.getElementById('hero-tour-toggle');
                  const sources = video.querySelectorAll('source');
                  sources[sources.length - 1].addEventListener('error', () => {
                    video.parentElement.replaceWith(document.getElementById('hero-tour-fallback').content.cloneNode(true));
                  });
                  const show = (playing) => {
                    toggle.setAttribute('aria-label', playing ? 'Pause the tour' : 'Play the tour');
                    toggle.querySelector('[data-icon=pause]').hidden = !playing;
                    toggle.querySelector('[data-icon=play]').hidden = playing;
                  };
                  const play = () => {
                    video.preload = 'auto';
                    video.play().then(() => show(true), () => show(false));
                  };
                  toggle.hidden = false;
                  toggle.addEventListener('click', () => {
                    if (video.paused) play();
                    else { video.pause(); show(false); }
                  });
                  const still = matchMedia('(prefers-reduced-motion: reduce)');
                  if (!still.matches) play();
                  still.addEventListener('change', (e) => { if (e.matches) { video.pause(); show(false); } });
                })();
              </script>
            </div>
            <div class="absolute bottom-0 left-0 hidden w-[24%] max-w-[230px] rounded-[1.9rem] border border-[#2a4370] bg-[#0b1222] p-1.5 shadow-[0_30px_70px_rgba(0,0,0,0.6)] sm:block">
              <Image src={heroPhone} alt="The same dashboard on a phone" class="block w-full rounded-[1.5rem]" widths={[240, 460]} sizes="230px" loading="eager" />
            </div>
          </div>
        </div>
      </section>

      <!-- Social proof band -->
      <section class="border-y border-surface-border bg-surface-raised/50">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-3 px-5 py-5 text-sm font-medium text-tx-secondary">
          {proof.map((p) => (
            <span class="flex items-center gap-2">
              <svg class="h-4 w-4 text-brand-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={check} clip-rule="evenodd"/></svg>
              {p.href ? <a href={p.href} class="transition hover:text-brand-300">{p.label}</a> : p.label}
            </span>
          ))}
        </div>
      </section>

      <!-- Tour -->
      <section id="tour" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-20">
        <h2 class="text-center font-display text-3xl font-bold tracking-tight sm:text-4xl">One app, every screen</h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-tx-secondary">
          The web app your server hosts and the Android app are the same code, so what you see on
          the desktop is what you get at the gym.
        </p>

        <div class="mt-16 space-y-20 lg:space-y-28">
          {tour.map((row, i) => (
            <article class="grid items-center gap-10 lg:grid-cols-12">
              <div class={`lg:col-span-4 ${i % 2 ? 'lg:order-2' : ''}`}>
                <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-brand-400">
                  {String(i + 1).padStart(2, '0')} · {row.kicker}
                </p>
                <h3 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">{row.t}</h3>
                <p class="mt-4 text-tx-secondary">{row.d}</p>
              </div>
              <div class={`relative lg:col-span-8 ${i % 2 ? 'lg:order-1' : ''}`}>
                <div class={`w-[86%] overflow-hidden rounded-xl border border-surface-border shadow-card-md ${i % 2 ? 'ml-auto' : ''}`}>
                  <Image src={row.desktop} alt={row.desktopAlt} class="block w-full" widths={[480, 760, 1140]} sizes="(max-width: 1024px) 86vw, 640px" loading="lazy" />
                </div>
                <div class={`absolute -bottom-6 w-[27%] max-w-[200px] rounded-[1.6rem] border border-[#2a4370] bg-[#0b1222] p-1 shadow-[0_24px_60px_rgba(0,0,0,0.55)] ${i % 2 ? 'left-0' : 'right-0'}`}>
                  <Image src={row.phone} alt={row.phoneAlt} class="block w-full rounded-[1.35rem]" widths={[200, 400]} sizes="200px" loading="lazy" />
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-24 overflow-hidden rounded-xl border border-surface-border shadow-glow-sm">
          <Image src={shotCharts} alt="Dashboard charts on desktop: muscle balance, volume trend, bodyweight and a 12-week consistency heatmap" class="block w-full" widths={[640, 1000, 1440]} sizes="(max-width: 1152px) 100vw, 1104px" loading="lazy" />
        </div>
        <p class="mt-3 text-center text-sm text-tx-muted">The dashboard on desktop: muscle balance, volume trend, bodyweight and twelve weeks of consistency.</p>
      </section>

      <!-- Features + why self-host -->
      <section class="border-t border-surface-border bg-surface-raised/30">
        <div class="mx-auto grid max-w-6xl gap-14 px-5 py-20 lg:grid-cols-2">
          <div>
            <h2 class="font-display text-3xl font-bold tracking-tight">Also in the box</h2>
            <dl class="mt-8 grid gap-x-6 gap-y-6 sm:grid-cols-2">
              {features.map((f) => (
                <div>
                  <dt class="font-display text-base font-bold text-tx-primary">{f.t}</dt>
                  <dd class="mt-1 text-sm text-tx-secondary">{f.d}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div>
            <h2 class="font-display text-3xl font-bold tracking-tight">Why self-host it?</h2>
            <ul class="mt-8 space-y-5">
              {values.map((v) => (
                <li class="flex gap-3">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={check} clip-rule="evenodd"/></svg>
                  <div>
                    <h3 class="font-display text-base font-bold text-tx-primary">{v.t}</h3>
                    <p class="mt-1 text-sm text-tx-secondary">{v.d}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Quick start -->
      <section id="quick-start" class="mx-auto max-w-4xl scroll-mt-20 px-5 py-20">
        <h2 class="text-center font-display text-3xl font-bold tracking-tight sm:text-4xl">Self-host in a few commands</h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-tx-secondary">No clone. No build. No Go install. Just Docker.</p>
        <div class="mt-8 overflow-hidden rounded-2xl border border-surface-border bg-[#050a14]">
          <div class="flex items-center gap-2 border-b border-surface-border px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-error-500/70"></span>
            <span class="h-3 w-3 rounded-full bg-warning-500/70"></span>
            <span class="h-3 w-3 rounded-full bg-success-500/70"></span>
            <span class="ml-2 font-mono text-xs text-tx-muted">bash</span>
          </div>
          <pre class="overflow-x-auto p-5 font-mono text-sm leading-relaxed text-tx-secondary"><code>curl -o docker-compose.yml https://raw.githubusercontent.com/Cawlumm/lyftr/main/docker-compose.yml
curl -o .env https://raw.githubusercontent.com/Cawlumm/lyftr/main/.env.example

<span class="text-tx-muted"># set JWT_SECRET in .env to a long random string (openssl rand -hex 32), then:</span>
docker compose pull &amp;&amp; docker compose up -d</code></pre>
        </div>
        <p class="mt-4 text-center text-sm text-tx-muted">
          Then open <code class="font-mono text-tx-secondary">http://localhost</code> and create your account.
          Full guide in the <a href={`${base}self-hosting/`} class="text-brand-400 underline-offset-2 hover:underline">self-hosting docs</a>.
        </p>
      </section>

      <!-- Runs on -->
      <section class="border-t border-surface-border bg-surface-raised/30">
        <div class="mx-auto max-w-6xl px-5 py-14">
          <p class="text-center text-sm font-semibold uppercase tracking-wider text-tx-muted">Runs on</p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            {runsOn.map((r) => (
              <span class="rounded-full border border-surface-border bg-surface-raised px-4 py-2 text-sm text-tx-secondary">{r}</span>
            ))}
          </div>
          <p class="mt-6 text-center text-sm text-tx-muted">Images for amd64, arm64 and armv7 · a single SQLite file · no external database.</p>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="mx-auto max-w-4xl px-5 py-20 text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Own your training data.</h2>
        <p class="mx-auto mt-3 max-w-xl text-tx-secondary">Try the demo now, or deploy your own instance in a couple of minutes.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={DEMO} class="rounded-xl bg-brand-500 px-6 py-3.5 font-semibold text-white shadow-glow-sm transition hover:bg-brand-600">Try the live demo</a>
          <a href={APK} class="rounded-xl border border-surface-border bg-surface-raised px-6 py-3.5 font-semibold text-tx-primary transition hover:border-tx-muted">Download Android APK</a>
        </div>
      </section>
    </main>

    <footer class="border-t border-surface-border">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-8 text-sm text-tx-muted sm:flex-row">
        <p>© 2026 Lyftr · MIT License</p>
        <div class="flex flex-wrap items-center gap-5">
          <a href={REPO} class="hover:text-tx-primary">GitHub</a>
          <a href={DISCORD} class="hover:text-tx-primary">Discord</a>
          <a href={DEMO} class="hover:text-tx-primary">Live demo</a>
          <a href={`${base}getting-started/`} class="hover:text-tx-primary">Docs</a>
          <a href={`${base}support/`} class="hover:text-tx-primary">Support</a>
        </div>
      </div>
    </footer>
  </body>
</html>
