# Required
# Signs every login. Generate your own and paste it here: openssl rand -hex 32
# Left empty on purpose: the server refuses to start in production without a private value.
JWT_SECRET=

# Optional
CORS_ORIGIN=http://localhost
PORT=80

# open | first-user | closed — https://lyftr-app.pages.dev/configuration/#locking-down-registration
REGISTRATION=first-user

# Seeds demo@lyftr.local, whose password is public. Leave off on a reachable instance.
DEMO_MODE=false

# Where the exercise catalog is downloaded from (open-exercise-db). Lyftr imports it at
# startup and every 24 hours after, and keeps its own copy. Unset uses the hosted instance;
# set it to use a catalog you host.
# OEDB_BASE_URL=https://oedb-api-o4dqddih5q-uk.a.run.app

# Static copies of that catalog, comma-separated and tried in order, which Lyftr reads before
# it asks the API. Unset: the hosted copies, but only while OEDB_BASE_URL is unset too (a
# catalog you host is never mixed with the hosted copy). `off` always asks the API.
# OEDB_CATALOG_URLS=https://cawlumm.github.io/open-exercise-db/v1,https://raw.githubusercontent.com/Cawlumm/open-exercise-db/catalog/v1

# Address the frontend's nginx proxies /api to, over the internal Docker network.
# This MUST be the backend's Docker service name (backend) — NOT your host/LAN IP.
# Only change the port, and only if you set a custom backend PORT, e.g. backend:3008.
# A host IP like 192.168.1.10:3000 gives a 502 Bad Gateway: in the default compose
# the backend's port is only exposed on the Docker network, not published to the host.
BACKEND_ORIGIN=backend:3000

# Peers whose X-Forwarded-For is believed for rate limiting (comma-separated CIDRs).
# Default: loopback and private ranges. Narrow it to your proxy when other hosts on the LAN can reach the backend.
# TRUSTED_PROXIES=
