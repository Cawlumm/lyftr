# Required
JWT_SECRET=change-me-to-a-random-32-plus-character-string

# Optional
CORS_ORIGIN=http://localhost
PORT=80

# Who may create an account:
#   open        anyone (default)
#   first-user  only while no account exists — claim your instance on first visit
#   closed      nobody; /api/v1/auth/register always returns 403
# Recommended for a single-user or family instance on a public hostname: first-user.
# Takes effect on container restart; no rebuild needed.
REGISTRATION=open

# Seeds the demo account (demo@lyftr.local) and 8 weeks of sample data. Its password is
# published in the docs, so leave this off on anything reachable from the internet —
# it is a working login regardless of REGISTRATION.
DEMO_MODE=false

# Address the frontend's nginx proxies /api to, over the internal Docker network.
# This MUST be the backend's Docker service name (backend) — NOT your host/LAN IP.
# Only change the port, and only if you set a custom backend PORT, e.g. backend:3008.
# A host IP like 192.168.1.10:3000 gives a 502 Bad Gateway: in the default compose
# the backend's port is only exposed on the Docker network, not published to the host.
BACKEND_ORIGIN=backend:3000
